# Python byte-code and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Packaging artifacts
build/
dist/
*.egg-info/

# Test coverage
.coverage
htmlcov/

# IDE settings
.idea/
.vscode/

# Secrets and credentials. Nothing of the sort exists in this repo and
# nothing should, but a governance scanner is a bad place to learn that
# .gitignore was one line short.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
credentials
credentials.*
.netrc
.pypirc
.npmrc
secrets.*

# checkride's own report output. `checkride . --sarif > report.sarif` in
# the repo root is a very easy accident to commit.
*.sarif
checkride-report.json

# OS noise
Thumbs.db
desktop.ini
.DS_Store
